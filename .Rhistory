# Define canonical names expected by the exam
canonical_names <- c(
SalePrice   = c("SalePrice", "Sale_Price", "Sale_Price ($)", "price", "saleprice"),
GrLivArea   = c("GrLivArea", "Gr_Liv_Area", "Gr.Liv.Area", "Living.Area", "Above.Ground.Living.Area"),
OverallQual = c("OverallQual", "Overall_Qual", "Overall.Qual", "OverallQuality"),
GarageCars  = c("GarageCars", "Garage_Cars", "Garage.Cars", "Garage_Capacity"),
LotArea     = c("LotArea", "Lot_Area", "Lot.Area", "Land.Area"),
YearBuilt   = c("YearBuilt", "Year_Built", "Year.Built", "BuiltYear"),
Neighborhood = c("Neighborhood", "Neighborhoods", "Neighbourhood", "Area")
)
# Function to rename the first matching found variable to canonical
rename_if_exists <- function(data, canon_map) {
for (target in names(canon_map)) {
possible <- canon_map[[target]]
found <- intersect(possible, names(data))
if (length(found) > 0) {
names(data)[match(found[1], names(data))] <- target
}
}
data
}
# Apply renaming logic
ames <- rename_if_exists(ames, canonical_names)
# Verify all required variables exist
required_vars <- names(canonical_names)
missing_vars <- setdiff(required_vars, names(ames))
if (length(missing_vars) > 0) {
stop(paste("The following required variables are missing after harmonization:",
paste(missing_vars, collapse = ", ")))
}
missing_vars
