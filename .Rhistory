# Identify 3 "large area, low price" potential outliers ----
# heuristic: top 1% by GrLivArea & below 25th percentile Price
area_thr <- stats::quantile(ames_exam$GrLivArea, 0.99)
price_thr <- stats::quantile(ames_exam$SalePrice, 0.25)
out_idx <- which(ames_exam$GrLivArea >= area_thr & ames_exam$SalePrice <= price_thr)
ames_exam$outlier_flag <- FALSE
ames_exam$outlier_flag[out_idx] <- TRUE
ggplot(ames_exam, aes(GrLivArea, SalePrice)) +
geom_point(alpha = 0.6) +
geom_point(data = subset(ames_exam, outlier_flag), shape = 21, size = 3, stroke = 1.2) +
labs(title = "Plot A: GrLivArea vs SalePrice",
subtitle = "High-area low-price candidates highlighted",
x = "Above-ground living area (sq ft)", y = "Sale Price ($)")
